[Unit]
Description=Rubik Pi — Kubernetes network reconciliation
Documentation=https://github.com/rubik-kuber
# Run after the network has a routable address (covers both DHCP and static)
After=network-online.target avahi-daemon.service
Wants=network-online.target avahi-daemon.service
# Must run before RKE2 so we can do a cluster-reset if the IP changed
Before=rke2-server.service rke2-agent.service
# If RKE2 is already up when we start (e.g. manual re-run), that is fine
Conflicts=

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/rubik-network-reconcile
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rubik-net-reconcile
# Give it up to 20 minutes (cluster-reset + API wait + Helm upgrade)
TimeoutStartSec=1200

[Install]
WantedBy=multi-user.target
